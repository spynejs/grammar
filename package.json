{
  "name": "@spynejs/grammar",
  "version": "0.3.0",
  "description": "The SpyneJS Generative Grammar — what AI agents read to write well-formed SpyneJS. Content-only package: cards (the operations), records (the constructions), the mental model, and the trees that route any task to them; versioned with framework releases.",
  "license": "MIT",
  "author": "Relevant Context, Inc.",
  "sideEffects": false,
  "files": [
    "grammar/",
    "manifest.json",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./grammar/*": "./grammar/*",
    "./kb/*": "./grammar/*"
  },
  "scripts": {
    "verify:pack": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spynejs/grammar.git"
  },
  "homepage": "https://github.com/spynejs/grammar#readme",
  "bugs": {
    "url": "https://github.com/spynejs/grammar/issues"
  },
  "keywords": [
    "spynejs",
    "generative-grammar",
    "knowledge-base",
    "agent-knowledge-base",
    "ai-agents",
    "llm-context",
    "frontend",
    "framework",
    "documentation"
  ]
}
